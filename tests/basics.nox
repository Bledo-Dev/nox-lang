-- Plain Lua features should all still work in Nox
print("version:", _VERSION)
local function counter()
  local n = 0
  return function() n = n + 1; return n end
end
local c = counter(); c(); c()
print("closure:", c())
print("int division:", 7 // 2, "float:", 7 / 2, "power:", 2 ^ 10, "bits:", 6 & 3, 6 | 3, 1 << 4)
print("math.type:", math.type(3), math.type(3.0))
local t = setmetatable({}, { __index = function(_, k) return k .. "!" end })
print("metatable:", t.hello)
local co = coroutine.wrap(function() for i = 1, 3 do coroutine.yield(i * 10) end end)
print("coroutine:", co(), co(), co())
print("string:", ("nox"):upper(), string.format("%05.1f|%-4s|%x", 3.14159, "ab", 255))
print("gsub:", (("a,b,,c"):gsub(",", ";")))
print("utf8:", utf8.len("héllo☃"), utf8.char(9731))
local list = { 5, 2, 9, 1 }
table.sort(list)
print("sorted:", table.concat(list, " "))
for i = 1, 3 do
  if i == 2 then goto skip end
  print("goto loop", i)
  ::skip::
end
print("pcall error:", pcall(error, "boom"))
print("integer overflow wraps:", math.maxinteger + 1 == math.mininteger)
